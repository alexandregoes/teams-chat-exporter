{
  "manifest_version": 3,
  "name": "Teams Chat Exporter",
  "version": "1.1.0",
  "description": "Exporta o histórico de um chat específico do Microsoft Teams Web para HTML, Markdown, JSON ou TXT.",
  "homepage_url": "https://github.com/alexandregoes/teams-chat-exporter",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teams Chat Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
